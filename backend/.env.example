# Copie este arquivo para .env e preencha os valores da sua máquina.
# O .env NUNCA vai para o GitHub (está no .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ambar_marketplace

# Gere uma chave com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Origens extras do navegador separadas por vírgula (ex.: Live Server).
FRONTEND_ORIGIN=http://127.0.0.1:5500

# HOST=0.0.0.0 para ouvir outras interfaces, se sua hospedagem exigir.
# NODE_ENV=production exige HTTPS para o cookie Secure.
# TEST_DB_NAME=ambar_marketplace_test (testes recriam somente nomes com sufixo _test).
